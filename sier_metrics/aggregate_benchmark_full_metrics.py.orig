#!/usr/bin/env python3
"""Aggregate SER / XZ means, reuse WER, and emit the full LaTeX evaluation table."""

from __future__ import annotations

import _path_setup  # noqa: F401

import argparse
import json
import statistics
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from _ser_metrics import (
    classification_key,
    compute_ser_variants,
    dedupe_classification_rows,
    load_input_keys,
)

from asr_testing.config import ASR_FULL_METRICS, TESTING_ROOT
from asr_testing.eval_subset import (
    DEFAULT_AISHELL_LIMIT,
    DEFAULT_BENCHMARK_ROOT,
    DEFAULT_SUBSET_NAME,
    apply_eval_subset_to_model_dir,
    dedupe_pred_rows_by_source,
    dedupe_rows_by_source_error_key,
    filter_rows_by_utterance,
    load_composite_source_map,
    load_or_build_eval_subset,
)

ROOT = TESTING_ROOT.parents[1]
DEFAULT_MAPPING_ROOT = ROOT / "segments-mapping" / "benchmark"
DEFAULT_EVAL_OUTPUT_ROOT = ROOT / "evaluate-framework" / "outputs"
DEFAULT_WER_METRICS = ASR_FULL_METRICS / "wer_metrics.json"
DEFAULT_OUTPUT_JSON = ASR_FULL_METRICS / "full_metrics.json"
DEFAULT_OUTPUT_TEX = ASR_FULL_METRICS / "latex" / "large_scale_evaluation_full.tex"
DEFAULT_PYTHON = Path("/hpc_stor03/sjtu_home/xiaoyu.gu/miniconda3/envs/detailed-semantic/bin/python")
XZ_SCRIPT = ROOT / "evaluate-framework" / "scripts" / "add_acoustic_similarity_and_word_frequency_to_semantic_errors.py"

INCLUDED_MODELS = (
    "qwen3-asr",
    "whisper-large-v3",
    "whisper-large-v3-turbo",
    "sensevoice",
    "paraformer",
    "qwen-asr-flash-filetrans",
    "doubao",
)


@dataclass(frozen=True)
class TableRow:
    section: str
    display_name: str
    model_key: str | None


TABLE_ROWS: tuple[TableRow, ...] = (
    TableRow("open_source", "Qwen3-ASR", "qwen3-asr"),
    TableRow("open_source", "whisper-large-v3", "whisper-large-v3"),
    TableRow("open_source", "whisper-large-v3-turbo", "whisper-large-v3-turbo"),
    TableRow("open_source", "sensevoice", "sensevoice"),
    TableRow("open_source", "paraformer", "paraformer"),
    TableRow("closed_source", "Qwen3-ASR-Flash-Filetrans", "qwen-asr-flash-filetrans"),
    TableRow("closed_source", "Doubao Filetrans", "doubao"),
)

LATEX_TEMPLATE = """\\begin{{table}}[h]
\\caption{{{caption}}}
\\label{{{label}}}
\\centering
\\begin{{tabular}}{{lrrrrrr}}
\\hline
ASR System & WER $\\downarrow$ & SER $\\downarrow$ & better-SER $\\downarrow$ & $\\bar{{s}}^{{a}}$ & $\\bar{{s}}^{{l}}$ & $\\bar{{s}}^{{c}}$\\\\
\\hline
\\multicolumn{{7}}{{l}}{{\\textbf{{Open-Source Models}}}} \\\\
{open_source_rows}\\hline
\\multicolumn{{7}}{{l}}{{\\textbf{{Closed-Source Models}}}} \\\\
{closed_source_rows}\\hline
\\end{{tabular}}
\\end{{table}}
"""


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if not path.exists():
        return rows
    with path.open("r", encoding="utf-8") as handle:
        for line in handle:
            stripped = line.strip()
            if stripped:
                rows.append(json.loads(stripped))
    return rows


def fmt_pct(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.2f}"


def fmt_score(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.3f}"


def classification_status(model_dir: Path) -> dict[str, Any]:
    input_path = model_dir / "llm_classification_input.jsonl"
    result_path = model_dir / "results" / "classification_results.jsonl"
    expected = len(read_jsonl(input_path)) if input_path.exists() else 0
    got = len(read_jsonl(result_path)) if result_path.exists() else 0
    return {
        "expected": expected,
        "got": got,
        "complete": expected > 0 and got >= expected,
        "available": got > 0,
    }


def compute_ser(
    model_dir: Path,
    *,
    eval_utterance_ids: set[str] | None = None,
    composite_source_map: dict[str, tuple[str, str]] | None = None,
) -> dict[str, Any]:
    return compute_ser_variants(
        model_dir,
        eval_utterance_ids=eval_utterance_ids,
        composite_source_map=composite_source_map,
    )


def run_xz_scoring(
    *,
    model: str,
    model_dir: Path,
    eval_output_root: Path,
    python_bin: Path,
    force: bool = False,
    eval_utterance_ids: set[str] | None = None,
    composite_source_map: dict[str, tuple[str, str]] | None = None,
) -> Path | None:
    input_path = model_dir / "results" / "classification_results.jsonl"
    output_path = eval_output_root / f"benchmark.{model}.semantic_xz.jsonl"
    if not input_path.exists() or input_path.stat().st_size == 0:
        return None
    if output_path.exists() and output_path.stat().st_size > 0 and not force:
        if eval_utterance_ids is None:
            return output_path

    rows = read_jsonl(input_path)
    if eval_utterance_ids is not None:
        rows = filter_rows_by_utterance(rows, eval_utterance_ids)
    input_keys = load_input_keys(model_dir)
    if input_keys:
        rows = [row for row in rows if classification_key(row) in input_keys]
    rows = dedupe_classification_rows(rows)
    if composite_source_map:
        rows, _ = dedupe_rows_by_source_error_key(rows, composite_source_map)
    if not rows:
        return None

    filtered_input = model_dir / "results" / "classification_results.eval.jsonl"
    filtered_input.parent.mkdir(parents=True, exist_ok=True)
    with filtered_input.open("w", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False) + "\n")

    if output_path.exists() and output_path.stat().st_size > 0 and not force and eval_utterance_ids is None:
        return output_path
    cmd = [
        str(python_bin),
        str(XZ_SCRIPT),
        "--input-jsonl",
        str(filtered_input),
        "--output-jsonl",
        str(output_path),
        "--x-score-mode",
        "ipa_edit",
        "--phonetic-mode",
        "ipa",
    ]
    print("+", " ".join(cmd), flush=True)
    subprocess.run(cmd, check=True)
    return output_path


def compute_dimension_means(scores_path: Path) -> dict[str, Any]:
    rows = read_jsonl(scores_path)
    x_scores: list[float] = []
    z_scores: list[float] = []
    y_scores: list[float] = []
    for row in rows:
        acoustic = row.get("acoustic_confusability")
        lexical = row.get("lexical_frequency_bias")
        if isinstance(acoustic, dict) and acoustic.get("score") is not None:
            x_scores.append(float(acoustic["score"]))
        if isinstance(lexical, dict) and lexical.get("score") is not None:
            z_scores.append(float(lexical["score"]))
        gap = row.get("context_best_gap")
        if gap is not None:
            y_scores.append(float(gap))
    return {
        "score_rows": len(rows),
        "x_count": len(x_scores),
        "z_count": len(z_scores),
        "y_count": len(y_scores),
        "s_a_mean": statistics.fmean(x_scores) if x_scores else None,
        "s_l_mean": statistics.fmean(z_scores) if z_scores else None,
        "s_c_mean": statistics.fmean(y_scores) if y_scores else None,
        "scores_path": str(scores_path),
    }


def resolve_scores_path(eval_output_root: Path, model: str) -> Path | None:
    xyz_scores = eval_output_root / f"benchmark.{model}.semantic_xyz_scores.jsonl"
    xz_scores = eval_output_root / f"benchmark.{model}.semantic_xz.jsonl"
    if xyz_scores.exists() and xyz_scores.stat().st_size > 0:
        return xyz_scores
    if xz_scores.exists() and xz_scores.stat().st_size > 0:
        return xz_scores
    return None


def load_wer_lookup(wer_metrics_path: Path) -> dict[str, float | None]:
    if not wer_metrics_path.exists():
        return {}
    payload = json.loads(wer_metrics_path.read_text(encoding="utf-8"))
    models = payload.get("models") or {}
    lookup: dict[str, float | None] = {}
    for key, metrics in models.items():
        reported = metrics.get("reported_in_tex")
        if reported is None:
            reported = metrics.get("wer") if metrics.get("coverage", 0) >= 0.98 else None
        lookup[key] = reported
    return lookup


def render_row(
    display_name: str,
    *,
    wer: float | None,
    ser: float | None,
    better_ser: float | None,
    s_a: float | None,
    s_l: float | None,
    s_c: float | None,
) -> str:
    return (
        f"{display_name} & {fmt_pct(wer)} & {fmt_pct(ser)} & {fmt_pct(better_ser)} & "
        f"{fmt_score(s_a)} & {fmt_score(s_l)} & {fmt_score(s_c)} \\\\"
    )


def build_latex(model_metrics: dict[str, dict[str, Any]], wer_lookup: dict[str, float | None]) -> str:
    open_rows: list[str] = []
    closed_rows: list[str] = []
    for row in TABLE_ROWS:
        if row.model_key is None:
            rendered = render_row(
                row.display_name,
                wer=None,
                ser=None,
                better_ser=None,
                s_a=None,
                s_l=None,
                s_c=None,
            )
        else:
            metrics = model_metrics.get(row.model_key, {})
            rendered = render_row(
                row.display_name,
                wer=wer_lookup.get(row.model_key),
                ser=metrics.get("ser"),
                better_ser=metrics.get("better_ser"),
                s_a=metrics.get("s_a_mean"),
                s_l=metrics.get("s_l_mean"),
                s_c=metrics.get("s_c_mean"),
            )
        if row.section == "open_source":
            open_rows.append(rendered)
        else:
            closed_rows.append(rendered)
    return LATEX_TEMPLATE.format(
        caption="Large-scale evaluation on the constructed benchmark.",
        label="tab:large-scale-evaluation",
        open_source_rows="\n".join(open_rows) + "\n",
        closed_source_rows="\n".join(closed_rows) + "\n",
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mapping-root", type=Path, default=DEFAULT_MAPPING_ROOT)
    parser.add_argument("--eval-output-root", type=Path, default=DEFAULT_EVAL_OUTPUT_ROOT)
    parser.add_argument("--wer-metrics", type=Path, default=DEFAULT_WER_METRICS)
    parser.add_argument("--output-json", type=Path, default=DEFAULT_OUTPUT_JSON)
    parser.add_argument("--output-tex", type=Path, default=DEFAULT_OUTPUT_TEX)
    parser.add_argument("--models", nargs="+", default=list(INCLUDED_MODELS))
    parser.add_argument("--python", type=Path, default=DEFAULT_PYTHON)
    parser.add_argument(
        "--skip-xz",
        action="store_true",
        help="Reuse existing XZ outputs if present; do not recompute",
    )
    parser.add_argument(
        "--partial",
        action="store_true",
        help="Fill metrics only for models with available classification/XZ outputs",
    )
    parser.add_argument("--benchmark-root", type=Path, default=DEFAULT_BENCHMARK_ROOT)
    parser.add_argument(
        "--eval-subset",
        type=Path,
        default=None,
        help=f"Eval subset JSON (default: mapping-root/{DEFAULT_SUBSET_NAME})",
    )
    parser.add_argument(
        "--aishell-limit",
        type=int,
        default=DEFAULT_AISHELL_LIMIT,
        help="AISHELL-4 utterance cap for SER/X/Z (0 = use full benchmark)",
    )
    args = parser.parse_args()

    python_bin = args.python if args.python.exists() else Path(sys.executable)
    wer_lookup = load_wer_lookup(args.wer_metrics)
    model_metrics: dict[str, dict[str, Any]] = {}

    eval_utterance_ids: set[str] | None = None
    eval_subset_meta: dict[str, Any] | None = None
    composite_source_map = load_composite_source_map(args.benchmark_root)
    source_dedupe_meta = {
        "composite_utterances_mapped": len(composite_source_map),
        "dedupe_key": "(source_dataset, source_segment_id, focus_id)",
        "utterance_dedupe_key": "(source_dataset, source_segment_id)",
    }
    if args.aishell_limit > 0:
        subset_path = args.eval_subset
        if subset_path is None:
            subset_path = args.mapping_root / DEFAULT_SUBSET_NAME
        eval_utterance_ids, eval_subset_meta = load_or_build_eval_subset(
            benchmark_root=args.benchmark_root,
            subset_path=subset_path,
            aishell_limit=args.aishell_limit,
        )
        print(
            f"Using eval subset: {eval_subset_meta['eval_utterances']} utterances "
            f"(AISHELL-4 {eval_subset_meta['aishell_selected']}/{eval_subset_meta['aishell_total']})"
        )

    for model in args.models:
        model_dir = args.mapping_root / model
        status = classification_status(model_dir)
        if args.partial and not status["available"]:
            print(f"Skipping {model}: no classification results yet.")
            continue

        ser_metrics = compute_ser(
            model_dir,
            eval_utterance_ids=eval_utterance_ids,
            composite_source_map=composite_source_map,
        ) if status["available"] else {
            "utterances": len(
                filter_rows_by_utterance(
                    read_jsonl(model_dir / "pred.raw.jsonl"),
                    eval_utterance_ids,
                )
                if eval_utterance_ids is not None
                else read_jsonl(model_dir / "pred.raw.jsonl")
            ),
            "target_segments": 0,
            "classification_rows": 0,
            "duplicate_classification_rows": 0,
            "duplicate_source_error_rows": 0,
            "duplicate_source_utterances": 0,
            "error_spans": 0,
            "semantic_error_spans": 0,
            "semantic_error_target_segments": 0,
            "semantic_error_chunks": 0,
            "semantic_error_words": 0,
            "total_target_words": 0,
            "non_semantic_error_spans": 0,
            "ser": None,
            "better_ser": None,
            "s_ser": None,
            "c_ser": None,
            "w_ser": None,
        }

        xz_path = args.eval_output_root / f"benchmark.{model}.semantic_xz.jsonl"
        if status["available"] and (not args.skip_xz or not xz_path.exists() or xz_path.stat().st_size == 0):
            xz_path = run_xz_scoring(
                model=model,
                model_dir=model_dir,
                eval_output_root=args.eval_output_root,
                python_bin=python_bin,
                force=not args.skip_xz or eval_utterance_ids is not None,
                eval_utterance_ids=eval_utterance_ids,
                composite_source_map=composite_source_map,
            )
        elif not status["available"]:
            xz_path = None

        scores_path = resolve_scores_path(args.eval_output_root, model)
        if scores_path is None:
            dimension_metrics = {
                "score_rows": 0,
                "x_count": 0,
                "z_count": 0,
                "y_count": 0,
                "s_a_mean": None,
                "s_l_mean": None,
                "s_c_mean": None,
                "scores_path": None,
            }
        else:
            dimension_metrics = compute_dimension_means(scores_path)

        model_metrics[model] = {
            "display_name": next(
                (row.display_name for row in TABLE_ROWS if row.model_key == model),
                model,
            ),
            "classification": status,
            "wer": wer_lookup.get(model),
            **ser_metrics,
            **dimension_metrics,
        }
        print(
            f"{model}: cls={status['got']}/{status['expected']} "
            f"s-SER={fmt_pct(ser_metrics['s_ser'])} "
            f"c-SER={fmt_pct(ser_metrics['c_ser'])} "
            f"w-SER={fmt_pct(ser_metrics['w_ser'])} "
            f"s_a={fmt_score(dimension_metrics['s_a_mean'])} "
            f"s_l={fmt_score(dimension_metrics['s_l_mean'])} "
            f"s_c={fmt_score(dimension_metrics['s_c_mean'])} "
            f"WER={fmt_pct(wer_lookup.get(model))}"
        )

    summary = {
        "mapping_root": str(args.mapping_root),
        "wer_metrics": str(args.wer_metrics),
        "models": model_metrics,
        "eval_subset": eval_subset_meta,
        "source_dedupe": source_dedupe_meta,
        "notes": {
            "s_ser_definition": "semantic_error_spans / total_target_chunks",
            "c_ser_definition": "semantic_error_chunks_with_error_words / total_target_chunks",
            "w_ser_definition": "semantic_error_words(reference op-aligned) / total_target_words",
            "error_word_rule": "reference char aligned to $ or + in op_segment",
            "error_chunk_rule": "jieba chunk containing at least one error word",
            "ser_definition": "alias of s_ser",
            "better_ser_definition": "alias of c_ser",
            "chunk_denominator": "sum of jieba chunk counts over deduplicated target in pred.raw.jsonl keyed by (source_dataset, source_segment_id)",
            "word_denominator": "sum of word counts over deduplicated target in pred.raw.jsonl keyed by (source_dataset, source_segment_id)",
            "s_ser_numerator": "deduplicated semantic error segments keyed by (source_dataset, source_segment_id, focus_id)",
            "c_ser_numerator": "sum of jieba chunks with error words over reference_segment for deduplicated semantic error rows",
            "w_ser_numerator": "sum of error word units over reference_segment for deduplicated semantic error rows",
            "y_dimension": "context_best_gap mean on semantic-error spans (requires semantic_xyz_scores.jsonl)",
            "whisper_models": "included in SER/X/Z pipeline",
            "wer_source": "reused from wer_metrics.json",
            "aishell_eval_limit": args.aishell_limit if args.aishell_limit > 0 else None,
        },
    }
    args.output_json.parent.mkdir(parents=True, exist_ok=True)
    args.output_json.write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    latex = build_latex(model_metrics, wer_lookup)
    args.output_tex.write_text(latex, encoding="utf-8")
    print(f"Wrote {args.output_json}")
    print(f"Wrote {args.output_tex}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
