#!/usr/bin/env python3
"""Generate benchmark table T1: WER + s/c/c2/w/w2-SEER variants."""

from __future__ import annotations

import _path_setup  # noqa: F401

import argparse
import json
from collections import Counter
from pathlib import Path
from typing import Any

from _ser_metrics import compute_ser_variants

from asr_testing.config import ASR_FULL_METRICS, ASR_FULL_PREDICTIONS, TESTING_ROOT
from asr_testing.eval_subset import (
    dedupe_benchmark_text_map_by_source,
    load_composite_source_map,
)
from asr_testing.wer import (
    compute_wer,
    load_benchmark_ground_truth,
    load_model_predictions,
)

ROOT = TESTING_ROOT.parents[1]
DEFAULT_BENCHMARK_ROOT = ROOT / "benchmark" / "benchmark"
DEFAULT_MAPPING_ROOT = ROOT / "segments-mapping" / "benchmark"
DEFAULT_PREDICTION_ROOT = ASR_FULL_PREDICTIONS
DEFAULT_OUTPUT = ASR_FULL_METRICS / "tables" / "t1" / "metrics_table_t1.md"

MODELS: tuple[tuple[str, str], ...] = (
    ("qwen3-asr", "Qwen3-ASR"),
    ("whisper-large-v3", "Whisper-large-v3"),
    ("whisper-large-v3-turbo", "Whisper-large-v3-turbo"),
    ("sensevoice", "SenseVoice"),
    ("paraformer", "Paraformer"),
    ("qwen-asr-flash-filetrans", "Qwen-Flash-Filetrans"),
    ("doubao", "Doubao Filetrans"),
)


def is_aishell4_dataset(dataset_name: str) -> bool:
    normalized = dataset_name.strip().lower().replace("_", "-")
    return normalized in {"aishell-4", "aishell4"}


def build_allowed_composites(
    composite_source_map: dict[str, tuple[str, str]],
    *,
    source_dedupe: bool,
    exclude_aishell4: bool,
) -> set[str]:
    allowed: set[str] = set()
    seen_sources: set[tuple[str, str]] = set()
    for composite_id in sorted(composite_source_map):
        source_key = composite_source_map[composite_id]
        if exclude_aishell4 and is_aishell4_dataset(source_key[0]):
            continue
        if source_dedupe and source_key in seen_sources:
            continue
        seen_sources.add(source_key)
        allowed.add(composite_id)
    return allowed


def compute_model_wer(
    model_key: str,
    *,
    benchmark_root: Path,
    prediction_root: Path,
    source_dedupe: bool,
    allowed_composites: set[str] | None,
) -> dict[str, Any]:
    ground_truth = load_benchmark_ground_truth(benchmark_root)
    if allowed_composites is not None:
        allowed_wer_keys = {
            tuple(composite_id.split(":", 1)) for composite_id in allowed_composites
        }
        ground_truth = {
            key: value for key, value in ground_truth.items() if key in allowed_wer_keys
        }
    gt_meta: dict[str, Any] | None = None
    if source_dedupe:
        ground_truth, gt_meta = dedupe_benchmark_text_map_by_source(ground_truth, benchmark_root)

    predictions = load_model_predictions(
        prediction_root,
        model_key,
        benchmark_root=benchmark_root,
    )
    if source_dedupe:
        predictions, _ = dedupe_benchmark_text_map_by_source(predictions, benchmark_root)
    predictions = {key: predictions[key] for key in ground_truth if key in predictions}

    stats = compute_wer(predictions, ground_truth)
    return {
        "utterances": len(ground_truth),
        "dedupe_meta": gt_meta,
        "substitutions": stats.substitutions,
        "insertions": stats.insertions,
        "deletions": stats.deletions,
        "ref_chars": stats.ref_chars,
        "errors": stats.errors,
        "wer": stats.wer,
    }


def fmt_pct(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.2f}"


def fmt_int(value: int) -> str:
    return f"{value:,}"


def render_t1_3d_table(rows: list[dict[str, Any]]) -> str:
    lines = [
        "| 标号 | 模型 | 指标 | 率% | 分母 | 计数 | 拆分 |",
        "|:---:|---|:---:|---:|---:|---:|---|",
    ]
    for idx, row in enumerate(rows, start=1):
        model = row["display_name"]
        lines.extend(
            [
                f"| T1-{idx}a | {model} | WER | {fmt_pct(row['wer'])} | "
                f"{fmt_int(row['ref_chars'])} | {fmt_int(row['errors'])} | "
                f"{row['substitutions']}/{row['insertions']}/{row['deletions']} |",
                f"| | | s-SEER | {fmt_pct(row['s_ser'])} | "
                f"{fmt_int(row['total_target_chunks'])} | {fmt_int(row['error_spans'])} | "
                f"{row['semantic_error_spans']}/{row['non_semantic_error_spans']} |",
                f"| | | c-SEER | {fmt_pct(row['c_ser'])} | "
                f"{fmt_int(row['total_target_chunks'])} | {fmt_int(row['error_segment_error_chunks'])} | "
                f"{row['semantic_error_chunks']}/{row['non_semantic_error_chunks']} |",
                f"| | | c-SEER2 | {fmt_pct(row['c_ser2'])} | "
                f"{fmt_int(row['total_target_chunks'])} | {fmt_int(row['error_segment_hyp_error_chunks'])} | "
                f"{row['semantic_hyp_error_chunks']}/{row['non_semantic_hyp_error_chunks']} |",
                f"| | | w-SEER | {fmt_pct(row['w_ser'])} | "
                f"{fmt_int(row['total_target_words'])} | {fmt_int(row['error_segment_error_words'])} | "
                f"{row['semantic_error_words']}/{row['non_semantic_error_words']} |",
                f"| | | w-SEER2 | {fmt_pct(row['w_mer2'])} | "
                f"{fmt_int(row['total_target_words'])} | {fmt_int(row['semantic_edit_errors'])} | "
                f"S/I/D = {row['semantic_edit_substitutions']}/"
                f"{row['semantic_edit_insertions']}/{row['semantic_edit_deletions']} |",
            ]
        )
    return "\n".join(lines)


def render_ser_detail_table(rows: list[dict[str, Any]]) -> str:
    lines = [
        "| 标号 | 模型 | WER% | s-SER% | c-SER% | c-SEER2% | w-SER% | w-SEER2% | chunk总数 | word总数 | 语义段 | ref语义chunk | hyp语义chunk | 语义word | 语义编辑错误 |",
        "|:---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
    ]
    for idx, row in enumerate(rows, start=1):
        lines.append(
            f"| T1-{idx} | {row['display_name']} | {fmt_pct(row['wer'])} | "
            f"{fmt_pct(row['s_ser'])} | {fmt_pct(row['c_ser'])} | {fmt_pct(row['c_ser2'])} | {fmt_pct(row['w_ser'])} | "
            f"{fmt_pct(row['w_mer2'])} | "
            f"{fmt_int(row['total_target_chunks'])} | {fmt_int(row['total_target_words'])} | "
            f"{fmt_int(row['semantic_error_spans'])} | {fmt_int(row['semantic_error_chunks'])} | {fmt_int(row['semantic_hyp_error_chunks'])} | "
            f"{fmt_int(row['semantic_error_words'])} | {fmt_int(row['semantic_edit_errors'])} |"
        )
    return "\n".join(lines)


def generate(
    *,
    benchmark_root: Path,
    mapping_root: Path,
    prediction_root: Path,
    source_dedupe: bool,
    exclude_aishell4: bool,
) -> tuple[str, dict[str, Any]]:
    composite_source_map = load_composite_source_map(benchmark_root)
    allowed_composites = build_allowed_composites(
        composite_source_map,
        source_dedupe=source_dedupe,
        exclude_aishell4=exclude_aishell4,
    )
    if not source_dedupe and not exclude_aishell4:
        allowed_composites = None
    ser_source_map = composite_source_map if source_dedupe else None

    t1_rows: list[dict[str, Any]] = []
    for model_key, display_name in MODELS:
        wer = compute_model_wer(
            model_key,
            benchmark_root=benchmark_root,
            prediction_root=prediction_root,
            source_dedupe=source_dedupe,
            allowed_composites=allowed_composites,
        )
        ser = compute_ser_variants(
            mapping_root / model_key,
            allowed_composites=allowed_composites,
            composite_source_map=ser_source_map,
        )
        t1_rows.append(
            {
                "model_key": model_key,
                "display_name": display_name,
                **wer,
                **ser,
            }
        )

    scope_parts = [f"**{len(allowed_composites or composite_source_map)}** 条 composite utterance"]
    if exclude_aishell4:
        scope_parts.append("已排除 AISHELL-4")
    if source_dedupe:
        scope_parts.append("已按 `(source_dataset, source_segment_id)` 去重")
    else:
        scope_parts.append("未 source 去重")
    scope_note = "，".join(scope_parts) + "。"

    dataset_counts_before = Counter(dataset for dataset, _ in composite_source_map.values())
    included_ids = allowed_composites or set(composite_source_map)
    dataset_counts_after = Counter(
        composite_source_map[composite_id][0] for composite_id in included_ids
    )

    meta = {
        "source_dedupe": source_dedupe,
        "exclude_aishell4": exclude_aishell4,
        "dataset_counts_before": dict(sorted(dataset_counts_before.items())),
        "dataset_counts_after": dict(sorted(dataset_counts_after.items())),
        "utterances": t1_rows[0]["utterances"] if t1_rows else 0,
        "composite_before_dedupe": len(composite_source_map),
        "deduped_utterances": len(allowed_composites) if allowed_composites else len(composite_source_map),
        "ser_definitions": {
            "wer": "mixed-token WER (CJK character, Latin word)",
            "s_ser": "semantic_error_spans / total_target_chunks",
            "c_ser": "semantic_error_chunks_with_error_words / total_target_chunks",
            "c_ser2": "hypothesis semantic-error chunks containing substitution/insertion chars / total_target_chunks",
            "w_ser": "semantic_error_words / total_target_words",
            "w_mer2": "WER-compatible S+I+D over semantic error segments / total_target_words",
            "c_ser_count": "error_segment_error_chunks = all error segments, chunks with error words",
            "c_ser_split": "semantic_error_chunks / non_semantic_error_chunks",
            "c_ser2_count": "error_segment_hyp_error_chunks = all error segments, hyp chunks with error chars",
            "c_ser2_split": "semantic_hyp_error_chunks / non_semantic_hyp_error_chunks",
            "w_ser_count": "error_segment_error_words = all error segments, error words",
            "w_ser_split": "semantic_error_words / non_semantic_error_words",
            "w_mer2_count": "semantic_edit_errors = S+I+D over semantic error segments",
            "w_mer2_split": "semantic_edit_substitutions / semantic_edit_insertions / semantic_edit_deletions",
        },
        "models": {
            row["model_key"]: {
                key: row[key]
                for key in (
                    "display_name",
                    "wer",
                    "s_ser",
                    "c_ser",
                    "c_ser2",
                    "w_ser",
                    "w_mer2",
                    "ref_chars",
                    "errors",
                    "substitutions",
                    "insertions",
                    "deletions",
                    "total_target_chunks",
                    "total_target_words",
                    "error_spans",
                    "semantic_error_spans",
                    "non_semantic_error_spans",
                    "error_segment_error_chunks",
                    "non_semantic_error_chunks",
                    "semantic_error_chunks",
                    "error_segment_hyp_error_chunks",
                    "non_semantic_hyp_error_chunks",
                    "semantic_hyp_error_chunks",
                    "error_segment_error_words",
                    "non_semantic_error_words",
                    "semantic_error_words",
                    "semantic_edit_errors",
                    "semantic_edit_substitutions",
                    "semantic_edit_insertions",
                    "semantic_edit_deletions",
                    "non_semantic_edit_errors",
                    "non_semantic_edit_substitutions",
                    "non_semantic_edit_insertions",
                    "non_semantic_edit_deletions",
                )
            }
            for row in t1_rows
        },
    }

    markdown_parts = [
        "## [T1] 全量 benchmark — WER / s-SEER / c-SEER / c-SEER2 / w-SEER / w-SEER2",
        "",
        f"**[T1-NOTE]** {scope_note}"
        "每个模型 6 行：WER / s-SEER / c-SEER / c-SEER2 / w-SEER / w-SEER2。"
        "**s-SER** 分母=chunk 总数，计数=错误 segment 数，拆分=语义/非语义 segment。"
        "**c-SER** 分母=chunk 总数，计数=全部错误 segment 中含错误 word 的 chunk 数，"
        "拆分=语义错误 segment 的错误 chunk / 非语义错误 segment 的错误 chunk。"
        "**c-SEER2** 分母与 c-SEER 相同，计数改为 hypothesis 侧含替换或插入错误字符的 jieba chunk 数，"
        "拆分=hyp 侧语义错误 chunk / 非语义错误 chunk。"
        "**w-SER** 分母=word 总数，计数=全部错误 segment 的错误 word 数，"
        "拆分=语义错误 segment 的错误 word / 非语义错误 segment 的错误 word。"
        "**w-SEER2** 分母与 WER 相同，计数=语义错误 segment 内按 WER 同口径计算的 S+I+D，"
        "拆分=这些 segment 内的 S/I/D。",
        "",
        render_t1_3d_table(t1_rows),
        "",
        "## [T1-SER] 汇总",
        "",
        render_ser_detail_table(t1_rows),
        "",
    ]
    return "\n".join(markdown_parts) + "\n", meta


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--benchmark-root", type=Path, default=DEFAULT_BENCHMARK_ROOT)
    parser.add_argument("--mapping-root", type=Path, default=DEFAULT_MAPPING_ROOT)
    parser.add_argument("--prediction-root", type=Path, default=DEFAULT_PREDICTION_ROOT)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument(
        "--source-dedupe",
        action="store_true",
        help="Apply source-level dedupe (default: full 681 composite utterances)",
    )
    parser.add_argument(
        "--include-aishell4",
        action="store_true",
        help="Include AISHELL-4 (default: exclude it from WER and all SEER variants)",
    )
    args = parser.parse_args()

    markdown, meta = generate(
        benchmark_root=args.benchmark_root,
        mapping_root=args.mapping_root,
        prediction_root=args.prediction_root,
        source_dedupe=args.source_dedupe,
        exclude_aishell4=not args.include_aishell4,
    )
    args.output.parent.mkdir(parents=True, exist_ok=True)
    json_path = args.output.with_suffix(".json")
    json_path.write_text(
        json.dumps({"meta": meta, "markdown": markdown}, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    args.output.write_text(markdown, encoding="utf-8")
    print(json.dumps(meta, ensure_ascii=False, indent=2))
    print(f"Wrote {args.output}")
    print(f"Wrote {json_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
